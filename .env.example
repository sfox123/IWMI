# ---- Branding ----
NEXT_PUBLIC_ORG_NAME=IWMI
NEXT_PUBLIC_FORM_TITLE=Data Request Portal

# ---- Admin login (protects /admin and file downloads) ----
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# ---- Storage mode ----
# "local" = files in ./data/uploads and records in a SQLite database at ./data/portal.db
# "aws"   = files in S3 and records in DynamoDB (recommended for production)
STORAGE_MODE=local
SQLITE_PATH=./data/portal.db

# ---- AWS (only when STORAGE_MODE=aws) ----
AWS_REGION=ap-south-1
S3_BUCKET=iwmi-data-requests
S3_PREFIX=data-requests
DYNAMODB_TABLE=data-request-submissions
# Credentials come from the usual AWS chain (IAM role, AWS_PROFILE, or keys)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Max upload size in MB
MAX_UPLOAD_MB=500
